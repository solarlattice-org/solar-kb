{% extends "base.html.j2" %}
{% from "_macros.html.j2" import link %}
{% block head %}
<script src="{{ lookup_href }}" defer></script>
{% endblock %}
{% block main %}
<p class="kind crumbs"><a href="{{ fc_index_href }}">Fault codes</a> › {{ make_name }}</p>
<h1>{{ make_name }} fault codes</h1>
<form class="fc-lookup" data-fc-lookup hidden>
<label>Filter codes <input type="search" name="code" placeholder="3701, Protect0090, event 3501" autocomplete="off"></label>
<p class="fc-results empty" aria-live="polite"></p>
</form>
{% for f in families %}
<h2 id="{{ f.slug }}">{{ f.name }}</h2>
<table class="codes">
<thead><tr><th>Code</th><th>Shown as</th><th>Class</th><th>Production</th><th>Clears</th><th>Reports</th><th>Page</th></tr></thead>
<tbody>
{% for row in f.rows %}
<tr data-key="{{ row.code_key }}"{% if row.code_from is not none %} data-from="{{ row.code_from }}" data-to="{{ row.code_to }}"{% endif %}>
<td>{{ link(row.code) }}</td><td>{{ row.display_message }}</td>
<td>{% if row.event_class %}{{ link(row.event_class) }}{% endif %}</td>
<td>{% if row.production %}{{ link(row.production) }}{% endif %}</td>
<td>{% if row.recovery %}{{ link(row.recovery) }}{% endif %}</td>
<td>{% for ref in row.reports %}{{ link(ref) }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
<td>{{ row.page }}</td>
</tr>
{% endfor %}
</tbody>
</table>
{% endfor %}
<p class="help">Codes are sorted by vendor prefix and number. Each row links to the code's record; concepts link to their reading rule.</p>
{% endblock %}
