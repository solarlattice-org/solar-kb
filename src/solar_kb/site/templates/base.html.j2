<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if title != "Solar Lattice" %} · Solar Lattice{% endif %}</title>
{% if canonical %}
<link rel="canonical" href="{{ canonical }}">
{% endif %}
{% block head %}{% endblock %}
<link rel="stylesheet" href="{{ rel('static/style.css') }}">
</head>
<body>
<header class="site">
<a class="brand" href="{{ rel('index.html') }}">Solar Lattice</a>
<nav><a href="{{ rel('kb/index.html') }}">Knowledge base</a><a href="{{ rel('kb/schema.html') }}">Ontology</a><a href="https://github.com/solarlattice-org/solar-kb">GitHub</a></nav>
</header>
<main>
{% block main %}{% endblock %}
</main>
<footer class="site">
Code: Apache-2.0 · Schema and records: <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · Schema {{ schema_version }}
</footer>
</body>
</html>
