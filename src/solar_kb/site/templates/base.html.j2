<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if title != "Solar Lattice" %} · Solar Lattice{% endif %}</title>
<meta name="description" content="Cited, typed knowledge about photovoltaic systems for people in the field and the tools that support them.">
<link rel="icon" type="image/svg+xml" href="{{ rel('static/solar-lattice-mark.svg') }}">
<link rel="mask-icon" href="{{ rel('static/solar-lattice-mark.svg') }}" color="#242a25">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}{% if title != 'Solar Lattice' %} · Solar Lattice{% endif %}">
<meta property="og:description" content="Cited, typed knowledge about photovoltaic systems for people in the field and the tools that support them.">
<meta property="og:url" content="{{ canonical or 'https://solarlattice.org/' }}">
<meta property="og:image" content="https://solarlattice.org/static/solar-lattice-share.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}{% if title != 'Solar Lattice' %} · Solar Lattice{% endif %}">
<meta name="twitter:description" content="Cited, typed knowledge about photovoltaic systems for people in the field and the tools that support them.">
<meta name="twitter:image" content="https://solarlattice.org/static/solar-lattice-share.png">
{% if canonical %}
<link rel="canonical" href="{{ canonical }}">
{% endif %}
{% block head %}{% endblock %}
<link rel="stylesheet" href="{{ rel('static/style.css') }}">
</head>
<body>
<header class="site">
<a class="brand" href="{{ rel('index.html') }}" aria-label="Solar Lattice home">
<svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><path d="M6 8.5h28v23H6z"/><path d="M15.3 8.5v23M24.7 8.5v23M6 20h28"/><path class="brand-signal" d="M6 20h9.3l2.3-5.5 4.2 11 2.1-5.5H34"/></svg>
<span>Solar <strong>Lattice</strong></span>
</a>
<nav aria-label="Primary navigation"><a href="{{ rel('kb/index.html') }}">Knowledge base</a><a href="{{ rel('kb/schema.html') }}">Ontology</a><a href="https://github.com/solarlattice-org/solar-kb">GitHub <span aria-hidden="true">↗</span></a></nav>
</header>
<main>
{% block main %}{% endblock %}
</main>
<footer class="site">
<span>Built for clarity in the field.</span><span>Code: Apache-2.0 · Schema and records: <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · Schema {{ schema_version }}</span>
</footer>
</body>
</html>
