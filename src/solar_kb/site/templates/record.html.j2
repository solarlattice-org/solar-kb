{% extends "base.html.j2" %}
{% from "_macros.html.j2" import link %}
{% block head %}
<link rel="alternate" type="application/ld+json" href="{{ view.jsonld_href }}">
<script type="application/ld+json">{{ jsonld|safe }}</script>
{% endblock %}
{% block main %}
{% if view.status == "proposed" %}
<p class="banner proposed">Proposed — not yet reviewed. The compiler created this stub as a relation target; it has no approved content yet.</p>
{% endif %}
<p class="kind"><a href="{{ view.type_href }}">{{ view.type }}</a></p>
<h1>{{ view.name }}</h1>
<dl class="meta">
<dt>ID</dt><dd><code>{{ view.id }}</code></dd>
<dt>IRI</dt><dd><code>{{ view.iri }}</code></dd>
<dt>Status</dt><dd>{{ view.status }}</dd>
{% if view.aliases %}
<dt>Also known as</dt><dd>{{ view.aliases|join(", ") }}</dd>
{% endif %}
</dl>
{% if view.prose %}
<section class="prose">
{{ view.prose|safe }}
</section>
{% endif %}
{% if view.manifest %}
<h2>Source</h2>
<dl class="meta">
{% for label, value, url in view.manifest %}
<dt>{{ label }}</dt><dd>{% if url %}<a href="{{ url }}">{{ value }}</a>{% else %}{{ value }}{% endif %}</dd>
{% endfor %}
</dl>
{% endif %}
{% if view.groups %}
<h2>Claims</h2>
{% for heading, claims in view.groups %}
<h3><code>{{ heading }}</code></h3>
{% for c in claims %}
<article class="claim" id="{{ c.claim_id }}">
<p><a class="anchor" href="#{{ c.claim_id }}">{{ c.claim_id }}</a> <span class="badge {{ c.review }}">{{ c.review_label }}</span>
{% if c.target %} {{ link(c.target) }}{% endif %}
{% if c.value %} <span class="value">{{ c.value }}</span>{% if c.unit %} <a href="{{ c.unit_iri }}">{{ c.unit }}</a>{% endif %}{% endif %}
{% if c.by %} — told apart by {{ link(c.by) }}{% endif %}
</p>
{% if c.conditions %}
<p><span class="label">Conditions:</span> {{ c.conditions }}</p>
{% endif %}
{% if c.note %}
<p>{{ c.note }}</p>
{% endif %}
{% if c.quote %}
<blockquote>{{ c.quote }}</blockquote>
{% endif %}
<ul class="cites">
{% for cite in c.citations %}
<li>{{ link(cite.source) }} <code>{{ cite.loc }}</code> <code title="content hash of the cited passage">h={{ cite.h }}</code></li>
{% endfor %}
</ul>
{% if c.details or c.refs %}
<p class="details">
{% for label, value in c.details %}<span>{{ label }}: {{ value }}</span>{% endfor %}
{% for label, ref in c.refs %}<span>{{ label }}: {{ link(ref) }}</span>{% endfor %}
</p>
{% endif %}
</article>
{% endfor %}
{% endfor %}
{% endif %}
{% if view.referenced_by %}
<h2>Referenced by</h2>
<ul>
{% for i in view.referenced_by %}
<li>{{ link(i.source) }} <code>{{ i.rel }}</code> <a href="{{ i.claim_href }}">{{ i.claim_id }}</a></li>
{% endfor %}
</ul>
{% endif %}
{% if view.cited_by %}
<h2>Cited by</h2>
<ul>
{% for i in view.cited_by %}
<li>{{ link(i.source) }} <a href="{{ i.claim_href }}">{{ i.claim_id }}</a></li>
{% endfor %}
</ul>
{% endif %}
{% if view.mappings %}
<h2>Mappings</h2>
<ul>
{% for label, value, iri in view.mappings %}
<li>{{ label }}: <a href="{{ iri }}">{{ value }}</a></li>
{% endfor %}
</ul>
{% endif %}
<h2>Data</h2>
<ul>
<li><a href="{{ view.jsonld_href }}">This record as JSON-LD</a></li>
<li><a href="{{ view.records_jsonld_href }}">All records (records.jsonld)</a></li>
</ul>
{% endblock %}
