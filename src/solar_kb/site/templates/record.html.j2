{% extends "base.html.j2" %}
{% from "_macros.html.j2" import link %}
{% block head %}
<link rel="alternate" type="application/ld+json" href="{{ view.jsonld_href }}">
<script type="application/ld+json">{{ jsonld|safe }}</script>
{% endblock %}
{% block main %}
{% if view.status == "proposed" %}
<p class="banner proposed">Proposed — not yet reviewed. The compiler created this stub as a relation target; it has no approved content yet.</p>
{% endif %}
<p class="kind"><a href="{{ view.type_href }}">{{ view.type }}</a></p>
<h1>{{ view.name }}</h1>
<dl class="meta">
<dt>ID</dt><dd><code>{{ view.id }}</code></dd>
<dt>IRI</dt><dd><code>{{ view.iri }}</code></dd>
<dt>Status</dt><dd>{{ view.status }}</dd>
{% if view.aliases %}
<dt>Also known as</dt><dd>{{ view.aliases|join(", ") }}</dd>
{% endif %}
{% if view.category %}
<dt>Category</dt><dd>{{ view.category }}</dd>
{% endif %}
</dl>
{% if view.prose %}
<section class="prose">
{{ view.prose|safe }}
</section>
{% endif %}
{% if view.signals %}
<h2>Signals</h2>
<p class="help">Monitoring channels where this signature appears, named by SunSpec model point.</p>
<table class="signals">
<thead><tr><th>Point</th><th>Unit</th><th>Pattern</th></tr></thead>
<tbody>
{% for point, unit, unit_iri, pattern in view.signals %}
<tr><td><code>{{ point }}</code></td><td>{% if unit_iri %}<a href="{{ unit_iri }}">{{ unit }}</a>{% else %}{{ unit }}{% endif %}</td><td>{{ pattern }}</td></tr>
{% endfor %}
</tbody>
</table>
{% endif %}
{% if view.manifest %}
<h2>Source</h2>
<dl class="meta">
{% for label, value, url in view.manifest %}
<dt>{{ label }}</dt><dd>{% if url %}<a href="{{ url }}">{{ value }}</a>{% else %}{{ value }}{% endif %}</dd>
{% endfor %}
</dl>
{% endif %}
{% include "_claims.html.j2" %}
{% endblock %}
